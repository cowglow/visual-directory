{
  "name": "visual-directory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "scripts/dev-cert-ensure.sh",
    "dev": "vite --host --port 3000",
    "dev:ai": "claude --dangerously-skip-permissions",
    "dev:up": "pnpm backend:up && pnpm dev",
    "dev:down": "docker compose down",
    "docker:dev": "docker compose run --service-ports frontend bash",
    "build": "tsc && vite build",
    "lint": "eslint frontend e2e --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "format": "prettier . --write",
    "test": "vitest --coverage",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "backend:up": "docker compose up -d db api adminer",
    "backend:up:local": "RESEND_API_KEY= EMAIL_FROM= docker compose up -d db api adminer",
    "backend:down": "docker compose down",
    "backend:logs": "docker compose logs -f api",
    "backend:migrate": "docker compose exec api pnpm prisma:deploy",
    "backend:seed": "docker compose exec ${DEV_SEED_LEADER_EMAIL:+-e SEED_LEADER_EMAIL=$DEV_SEED_LEADER_EMAIL} api pnpm seed",
    "backend:seed:demo": "docker compose exec ${DEV_SEED_LEADER_EMAIL:+-e SEED_LEADER_EMAIL=$DEV_SEED_LEADER_EMAIL} api pnpm seed:demo"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redux-saga": "^1.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.4.5",
    "@playwright/test": "^1.63.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@sakun/system.css": "^0.1.11",
    "@storybook/addon-actions": "^8.6.17",
    "@storybook/addon-backgrounds": "^8.6.17",
    "@storybook/addon-controls": "^8.6.17",
    "@storybook/addon-docs": "^8.6.17",
    "@storybook/addon-essentials": "^8.6.17",
    "@storybook/addon-interactions": "^8.6.17",
    "@storybook/addon-measure": "^8.6.17",
    "@storybook/addon-onboarding": "^8.6.17",
    "@storybook/addon-outline": "^8.6.17",
    "@storybook/addon-toolbars": "^8.6.17",
    "@storybook/blocks": "^8.6.17",
    "@storybook/instrumenter": "^8.6.17",
    "@storybook/react": "^8.6.17",
    "@storybook/react-vite": "^8.6.17",
    "@storybook/test": "^8.6.17",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vis.gl/react-maplibre": "^8.1.3",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^17.7.0",
    "maplibre-gl": "^6.9.0",
    "prettier": "^3.5.2",
    "react-redux": "^9.2.0",
    "storybook": "^8.6.17",
    "styled-components": "^6.1.15",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vite-plugin-checker": "^0.8.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf",
  "pnpm": {
    "overrides": {
      "@eslint/plugin-kit": "0.3.5",
      "js-yaml": "4.3.2",
      "@rollup/pluginutils": "5.4.0",
      "ajv": "6.15.0",
      "flatted": "3.4.2",
      "lodash": "4.18.1",
      "ws": "8.21.0",
      "@babel/core": "7.29.7",
      "postcss": "8.5.23",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.7",
      "yaml@>=1.0.0 <1.10.3": "1.10.3",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "vitest@<4.1.11": "4.1.11",
      "nanoid": "3.3.19",
      "browserslist": "4.28.9",
      "@humanfs/node": "0.16.8"
    }
  }
}
