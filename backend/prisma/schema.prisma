generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  leader
}

enum OrganizationType {
  Region
  Headquarter
  Area
  District
  Group
}

enum DepartmentType {
  MD
  WD
  JMD
  JWD
}

enum MemberStatusKind {
  active
  lost_contact
}

model Account {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role
  memberId  String?  @unique
  member    Member?  @relation(fields: [memberId], references: [id])
  createdAt DateTime @default(now())

  magicLinkTokens MagicLinkToken[]
  auditLogEntries AuditLogEntry[]
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  accountId String
  account   Account   @relation(fields: [accountId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Organization {
  id        String           @id @default(uuid())
  name      String
  type      OrganizationType
  parentId  String?
  parent    Organization?    @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children  Organization[]   @relation("OrganizationHierarchy")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members Member[]

  @@index([parentId])
}

model Member {
  id                  String            @id @default(uuid())
  firstName           String
  lastName            String
  street              String?
  number              String?
  zip                 Int?
  city                String?
  lat                 Float?
  lng                 Float?
  telephone           String?
  email               String?
  responsibilityLevel OrganizationType?
  responsibilityType  DepartmentType?
  organizationId      String?
  organization        Organization?     @relation(fields: [organizationId], references: [id])
  signupDate          DateTime          @default(now())
  statusKind          MemberStatusKind  @default(active)
  lastActiveDate      DateTime?
  incomplete          Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  account Account?
}

model AuditLogEntry {
  id             String   @id @default(uuid())
  sequence       Int      @default(autoincrement())
  timestamp      DateTime @default(now())
  actorAccountId String
  actorAccount   Account  @relation(fields: [actorAccountId], references: [id])
  entity         String
  entityId       String
  diff           Json
  prevHash       String
  hash           String   @unique

  @@index([sequence])
}

// --- Opt-in neighborhood maps (Spaces) ---
// Deliberately decoupled from Account/Member/Organization above: this is a
// separate, multi-tenant system (many independent neighborhoods, e.g. one per
// event) bolted onto the same app, not an extension of the single-organization
// directory. No foreign keys cross the boundary in either direction, and no
// audit log - that trail is a directory-specific trust mechanism, not a
// blanket app rule.
//
// Pivoted from a generic dynamic-field-schema opt-in form system to a fixed
// map-pin sign-up (docs/WORKLOG.md, 2026-09-21): one participant, one
// SpaceLocation pin, invite-only. The old FieldDef/OptInEvent/OptInEntry
// tables are gone - a single-purpose map has no use for a generic form
// builder, and keeping both would be an abstraction nobody asked for.

enum SpaceRole {
  // Owns a pin, can invite others, inherits every former "leader" capability
  // that still applies to a neighborhood map.
  participant
  // Read-only map access. Arrives by invite only, same as a participant.
  visitor
}

model Space {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  participants SpaceParticipant[]
  locations    SpaceLocation[]
  invites      SpaceInvite[]
}

model SpaceParticipant {
  id            String    @id @default(uuid())
  spaceId       String
  space         Space     @relation(fields: [spaceId], references: [id])
  email         String
  role          SpaceRole
  // GDPR consent record captured at invite-accept time - see
  // domain/audit... no, this system has no audit log (see comment above);
  // consentAt/noticeVersion IS the record, kept forever until the participant
  // is deleted (consent withdrawal = deletion, see "Remove me").
  consentAt     DateTime
  noticeVersion String
  createdAt     DateTime  @default(now())

  location        SpaceLocation?
  magicLinkTokens SpaceMagicLinkToken[]
  sentInvites     SpaceInvite[]         @relation("SpaceInviteInviter")

  @@unique([spaceId, email])
}

// One pin per participant (TASK.md section 1) - a 1:1 with SpaceParticipant
// rather than a list, so "one entry per participant" is enforced by the
// schema itself, not application logic.
model SpaceLocation {
  id            String   @id @default(uuid())
  spaceId       String
  space         Space    @relation(fields: [spaceId], references: [id])
  participantId String   @unique
  participant   SpaceParticipant @relation(fields: [participantId], references: [id])
  label         String
  note          String
  lat           Float
  lng           Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([spaceId])
}

model SpaceMagicLinkToken {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  participantId String
  participant   SpaceParticipant @relation(fields: [participantId], references: [id])
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

// A single-use, revocable invite token - separate from SpaceMagicLinkToken
// (which is only ever issued to an *existing* participant to sign back in).
// Accepting one is what creates the SpaceParticipant row in the first place;
// there's no other path to a participant/visitor account (section 2: "NO
// public access").
model SpaceInvite {
  id                    String    @id @default(uuid())
  spaceId               String
  space                 Space     @relation(fields: [spaceId], references: [id])
  email                 String
  role                  SpaceRole
  tokenHash             String    @unique
  inviterParticipantId  String
  inviter               SpaceParticipant @relation("SpaceInviteInviter", fields: [inviterParticipantId], references: [id])
  expiresAt             DateTime
  usedAt                DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())

  @@index([spaceId])
  @@index([email])
  @@index([inviterParticipantId])
}
