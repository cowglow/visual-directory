generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  leader
}

enum OrganizationType {
  Region
  Headquarter
  Area
  District
  Group
}

enum DepartmentType {
  MD
  WD
  JMD
  JWD
}

enum MemberStatusKind {
  active
  lost_contact
}

model Account {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role
  memberId  String?  @unique
  member    Member?  @relation(fields: [memberId], references: [id])
  createdAt DateTime @default(now())

  magicLinkTokens MagicLinkToken[]
  auditLogEntries AuditLogEntry[]
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  accountId String
  account   Account   @relation(fields: [accountId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Organization {
  id        String           @id @default(uuid())
  name      String
  type      OrganizationType
  parentId  String?
  parent    Organization?    @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children  Organization[]   @relation("OrganizationHierarchy")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  members Member[]

  @@index([parentId])
}

model Member {
  id                  String            @id @default(uuid())
  firstName           String
  lastName            String
  street              String?
  number              String?
  zip                 Int?
  city                String?
  lat                 Float?
  lng                 Float?
  telephone           String?
  email               String?
  responsibilityLevel OrganizationType?
  responsibilityType  DepartmentType?
  organizationId      String?
  organization        Organization?     @relation(fields: [organizationId], references: [id])
  signupDate          DateTime          @default(now())
  statusKind          MemberStatusKind  @default(active)
  lastActiveDate      DateTime?
  incomplete          Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  account Account?
}

model AuditLogEntry {
  id             String   @id @default(uuid())
  sequence       Int      @default(autoincrement())
  timestamp      DateTime @default(now())
  actorAccountId String
  actorAccount   Account  @relation(fields: [actorAccountId], references: [id])
  entity         String
  entityId       String
  diff           Json
  prevHash       String
  hash           String   @unique

  @@index([sequence])
}

// --- Opt-in signups (Spaces/Events/Entries) ---
// Deliberately decoupled from Account/Member/Organization above: this is a
// separate, multi-tenant system (many independent neighborhoods) bolted onto
// the same app, not an extension of the single-organization directory. No
// foreign keys cross the boundary in either direction, and no audit log -
// that trail is a directory-specific trust mechanism, not a blanket app rule.

model Space {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  participants SpaceParticipant[]
  events       OptInEvent[]
}

model SpaceParticipant {
  id          String   @id @default(uuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id])
  email       String
  displayName String?
  createdAt   DateTime @default(now())

  magicLinkTokens SpaceMagicLinkToken[]
  entries         OptInEntry[]

  @@unique([spaceId, email])
}

model SpaceMagicLinkToken {
  id            String    @id @default(uuid())
  tokenHash     String    @unique
  participantId String
  participant   SpaceParticipant @relation(fields: [participantId], references: [id])
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

model OptInEvent {
  id          String    @id @default(uuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id])
  slug        String
  title       String
  // Free-text tag ("trick-or-treat", "block-party", ...), not an enum - a new
  // kind of event never needs a migration.
  kind        String
  // FieldDef[] (see domain/space/space.types.ts) - what an entry's `data` must
  // contain for this event. The whole point: a new event type is a new
  // fieldSchema value, not a new table or form component.
  fieldSchema Json
  opensAt     DateTime?
  closesAt    DateTime?
  createdAt   DateTime  @default(now())

  entries OptInEntry[]

  @@unique([spaceId, slug])
}

model OptInEntry {
  id            String   @id @default(uuid())
  eventId       String
  event         OptInEvent @relation(fields: [eventId], references: [id])
  participantId String
  participant   SpaceParticipant @relation(fields: [participantId], references: [id])
  // Denormalized for sorting/display/print even though the full answer set
  // lives in `data` - avoids parsing JSON just to sort the list.
  addressLabel  String?
  data          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventId])
}
