VITE_API_URL=http://localhost:4000

# The rest are only read by root docker-compose.yml (pnpm backend:up / dev:all) —
# all optional, defaults below match docker-compose.yml's own ${VAR:-default}
# fallbacks, so this file only needs overriding if you want different local values.
# Not used for production — see docs/HETZNER_DEPLOY.md, which writes /opt's .env on
# the server from GitHub Secrets instead of a checked-in file.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=contact_book
JWT_SECRET=dev-secret-change-me
CLIENT_ORIGIN=https://localhost:3000
NODE_ENV=development

# Read by `pnpm backend:seed` (backend/prisma/seed.ts) to bootstrap the first
# leader account. Override for one run without editing this file:
# SEED_LEADER_EMAIL=you@example.com pnpm backend:seed
SEED_LEADER_EMAIL=leader@example.com

# Only used once both are set (see server/src/email.ts getMailer()) — until then,
# magic links log to the console instead. Get a free API key at https://resend.com.
RESEND_API_KEY=
EMAIL_FROM=
